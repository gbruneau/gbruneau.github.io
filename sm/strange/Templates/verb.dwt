<html>
<head>
<!-- #BeginEditable "doctitle" -->
<title>Verbe</title>
<!-- #EndEditable --> 
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
</head>

<body bgcolor="#99FFFF" text="#663300" link="#336666">
<p><font size="+5"><!-- #BeginEditable "Verbe" --><font size="+5">Plounschdre</font><!-- #EndEditable -->:</font> 
</p>
<!-- #BeginEditable "Definition" --><font size="+3">Action consistant &agrave; 
faire quelque chose avec une <a href="../ee/p/plounsche.htm" target="_self">plounsche</a> 
de quelque chose.</font> <!-- #EndEditable --> 
<hr>
<p><font size="+3"><i>Ex: <!-- #BeginEditable "Exemple" --><font size="+3"><i>Nous 
  <b><font color="#CC0000">plounschd&icirc;mes</font></b> quelque chose dans le 
  plafond.</i></font><!-- #EndEditable --></i></font></p>
<hr>
<table width="100%" border="1">
  <tr> 
    <td colspan="4" bgcolor="#6699FF"> 
      <div align="center"><b>Indicatif</b></div>
    </td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" bgcolor="#66CCFF"> 
      <div align="center"><b>Pr&eacute;sent</b></div>
    </td>
    <td width="25%" bgcolor="#66CCFF"> 
      <div align="center"><b>Imparfait</b></div>
    </td>
    <td width="25%" bgcolor="#66CCFF"> 
      <div align="center"><b>Pass&eacute; Simple</b></div>
    </td>
    <td width="25%" bgcolor="#66CCFF"> 
      <div align="center"><b>Futur Simple</b></div>
    </td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%"> <!-- #BeginEditable "Present" --> 
      <p>Je plounschds<br>
        Tu plounschds<br>
        Il plounschd<br>
        Nous plounschdons<br>
        Vous plounschdez<br>
        Ils plounschdent</p>
      <!-- #EndEditable --></td>
    <td width="25%"> <!-- #BeginEditable "Imparfait" -->
      <p>Je plounschdais<br>
        Tu plounschdais<br>
        Il plounschdait<br>
        Nous plounschdions<br>
        Vous plounschdiez<br>
        Ils plounschdaient </p>
      <!-- #EndEditable --></td>
    <td width="25%"><!-- #BeginEditable "Passe%20Simple" -->Je plounschdis<br>
      Tu plounschdis<br>
      Il plounschdit<br>
      Nous plounschd&icirc;mes<br>
      Vous plounschd&icirc;tes<br>
      Ils plounschdirent<!-- #EndEditable --></td>
    <td width="25%"><!-- #BeginEditable "Futur%20Simple" -->Je plounschdrai<br>
      Tu plounschdras<br>
      Il plounschdra<br>
      Nous plounschdrons<br>
      Vous plounschdrez<br>
      Ils plounschdront <!-- #EndEditable --></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="50%" colspan="2" bgcolor="#6699FF"><b>Subjonctif</b></td>
    <td width="25%" bgcolor="#6699FF"><b>Conditionnel</b></td>
    <td width="25%" bgcolor="#6699FF"><b>Participe</b></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" bgcolor="#66CCFF"><b>Pr&eacute;sent</b></td>
    <td width="25%" bgcolor="#66CCFF"><b>Imparfait</b></td>
    <td width="25%" bgcolor="#66CCFF"><b>Pr&eacute;sent</b></td>
    <td width="25%" bgcolor="#66CCFF"><b>Pr&eacute;sent</b></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" rowspan="3"><!-- #BeginEditable "subj-Present" -->Que je plounschde<br>
      Que tu plounschdes<br>
      Qu'il plounschde<br>
      Que nous plounschdions<br>
      Que vous plounschdiez<br>
      Qu'ils plounschdent<!-- #EndEditable --></td>
    <td width="25%" rowspan="3"><!-- #BeginEditable "Subj-Imparfait" -->Que je 
      plounschdisse<br>
      Que tu plounschdisses<br>
      Qu'il plounschd&icirc;t<br>
      Que nous plounschdissions<br>
      Que vous plounschdissiez<br>
      Qu'ils plounschdissent<!-- #EndEditable --></td>
    <td width="25%" rowspan="3"><!-- #BeginEditable "Cond-Present" -->Je plounschdrais<br>
      Tu plounschdrais<br>
      Il plounschdrait<br>
      Nous plounschdrions<br>
      Vous plounschdriez<br>
      Ils plounschdraient<!-- #EndEditable --></td>
    <td width="25%"><!-- #BeginEditable "Part-Present" -->Plounschdant<!-- #EndEditable --></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" bgcolor="#66CCFF"><b>Pass&eacute;</b></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%"><!-- #BeginEditable "Part-Passe" -->Plounschdu<br>
      Plounschdue<br>
      Plounschdus<br>
      Plounschdues<!-- #EndEditable --></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" bgcolor="#6699FF"><b>Imp&eacute;ratif</b></td>
    <td width="50%" bgcolor="#6699FF" colspan="2"><b>Notes</b></td>
    <td width="25%" bgcolor="#6699FF"><b>Infinitif</b></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%" bgcolor="#66CCFF"><b>Pr&eacute;sent</b></td>
    <td width="50%" colspan="2" rowspan="2"><!-- #BeginEditable "Notes" -->Transitif 
      direct, indirect.<!-- #EndEditable --></td>
    <td width="25%" bgcolor="#66CCFF"><b>Pr&eacute;sent</b></td>
  </tr>
  <tr valign="top" align="center"> 
    <td width="25%"><!-- #BeginEditable "Imper-Present" -->Plounschds<br>
      Plounschdons<br>
      Plounschdez<!-- #EndEditable --></td>
    <td width="25%"><!-- #BeginEditable "Infinitif" -->Plounschdre <!-- #EndEditable --></td>
  </tr>
</table>
<p>&nbsp;</p>
</body>
</html>
