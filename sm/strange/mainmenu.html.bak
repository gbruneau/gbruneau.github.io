  <script language="JavaScript">
function TimeSinceLastVisit(name)
   // Return the time in ms
{
var expdate = new Date ();
var NowTime = new Date();
var LastVisit = GetCookie(name)
expdate.setTime(expdate.getTime() + (24 * 60 * 60 * 1000 * 365));
if (LastVisit == null)
    {
    SetCookie(name,NowTime)
    return -1
    }
else
    {
    SetCookie(name,NowTime)
//    return Math.round((Date.parse(NowTime) - LastVisit) / (24 * 60 * 60 * 100 ))
    return Math.round((Date.parse(NowTime) - Date.parse(LastVisit)) )
    }
}function ShowLastVisit()
{
var m="";
var t=TimeSinceLastVisit("Bunge");
var j=Math.round(t / (1000 * 60 * 60 * 24));
var h=Math.round(t / (1000 * 60 * 60 ));
j=2
h=48
if ((j >=  30)) // Plus de 30 Jours
   {
   document.write("Vous n'avez pas visit&eacute; le site depuis "+ j + " Jours<br>");
   document.write("L'Empereur est tr&egrave;s m&eacute;content<br>");
   document.write('<a href="mailto://bunge@xooommail.com/">Expliquez vous en cliquant ici</a>');
   }
else if ((j >=  7)) // Plus de 7 Jours
   {
   document.write("Vous n'avez pas visit&eacute; le site depuis "+ j + " Jours<br>");
   document.write('<a href="mailto://bunge@xooommail.com/">Pourquoi ?</a>');
   }
else if ((h > 24)) // Plus de 24h
   {
   document.write("Vous n'avez pas visit&eacute; le site depuis "+ h + " heures<br>");
   document.write("Vous devriez regarder le site &agrave; <b>tous les jours</b><br>");
   }
}
</script>
