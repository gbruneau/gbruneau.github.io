# Cloudflare (Workers static assets and Pages) response headers.
# Other hosts, such as GitHub Pages, ignore this file.

# Vite's file names carry a content hash: safe to keep for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always check for a newer service worker and start page.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
